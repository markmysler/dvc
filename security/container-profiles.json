{
  "default": {
    "description": "Default security profile for all containers",
    "securityOpts": [
      "no-new-privileges:true"
    ],
    "capDrop": [
      "ALL"
    ],
    "capAdd": [],
    "user": "1000:1000",
    "readOnlyRootfs": true,
    "tmpfs": {
      "/tmp": "rw,noexec,nosuid,size=100m",
      "/var/tmp": "rw,noexec,nosuid,size=50m",
      "/run": "rw,noexec,nosuid,size=50m"
    },
    "sysctls": {
      "net.ipv4.ip_unprivileged_port_start": "0"
    },
    "ulimits": {
      "nofile": {
        "soft": 1024,
        "hard": 2048
      },
      "nproc": {
        "soft": 64,
        "hard": 128
      }
    }
  },
  "challenge": {
    "description": "Security profile for challenge containers: no capabilities, Docker's default seccomp profile, read-only root filesystem with small writable tmpfs mounts. Challenges write runtime data (e.g. the flag file) under /app/runtime.",
    "securityOpts": [
      "no-new-privileges:true"
    ],
    "capDrop": [
      "ALL"
    ],
    "capAdd": [],
    "user": "1000:1000",
    "readOnlyRootfs": true,
    "tmpfs": {
      "/tmp": "rw,noexec,nosuid,size=64m",
      "/var/tmp": "rw,noexec,nosuid,size=16m",
      "/run": "rw,noexec,nosuid,size=16m",
      "/app/runtime": "rw,noexec,nosuid,size=16m,uid=1000,gid=1000,mode=0755"
    },
    "sysctls": {
      "net.ipv4.ip_unprivileged_port_start": "0"
    },
    "ulimits": {
      "nofile": {
        "soft": 2048,
        "hard": 4096
      },
      "nproc": {
        "soft": 128,
        "hard": 256
      }
    },
    "resources": {
      "memory": "512m",
      "cpus": "1.0",
      "pidsLimit": 256
    }
  },
  "monitoring": {
    "description": "Security profile for monitoring containers",
    "securityOpts": [
      "no-new-privileges:true"
    ],
    "capDrop": [
      "ALL"
    ],
    "capAdd": [
      "NET_BIND_SERVICE"
    ],
    "user": "65534:65534",
    "readOnlyRootfs": true,
    "tmpfs": {
      "/tmp": "rw,noexec,nosuid,size=50m"
    },
    "ulimits": {
      "nofile": {
        "soft": 65536,
        "hard": 65536
      }
    }
  }
}
